# TMDB account > Settings > API > API Read Access Token (not the v3 API Key)
# Server only: never rename to NEXT_PUBLIC_*, and never commit .env.local.
TMDB_READ_ACCESS_TOKEN=

# PostHog project token (public client token beginning with phc_).
# Use https://eu.i.posthog.com instead when the project is in the EU region.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
