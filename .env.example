# TMDB account > Settings > API > API Read Access Token (not the v3 API Key)
# Server only: never rename to NEXT_PUBLIC_*, and never commit .env.local.
TMDB_READ_ACCESS_TOKEN=

# Optional. Amazon Associates tracking ID (xxxx-22). Empty: no Amazon affiliate links.
AMAZON_TAG=
# Optional. Overrides the built-in Rakuten affiliate id; set it empty to turn Rakuten links off.
# RAKUTEN_AFFILIATE_ID=
